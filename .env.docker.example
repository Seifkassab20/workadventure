# ==============================================================================
# WorkAdventure Docker Self-Hosting Configuration (.env)
# ==============================================================================
# Copy this file to '.env' before running docker compose:
#   cp .env.docker.example .env
#
# Or use the interactive setup script:
#   bash docker-setup.sh      (Linux / macOS)
#   .\docker-setup.ps1        (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMAIN & SSL CONFIGURATION
# ------------------------------------------------------------------------------
# For VPS / Production: Your full domain name pointing to your server's public IP
# Example: office.yourcompany.com
#
# For Local Testing: Use localhost
DOMAIN=office.yourcompany.com

# Email address used by Let's Encrypt for TLS certificate registration & renewal notices
# (Required for production HTTPS; ignored when running with docker-compose.local.yaml)
ACME_EMAIL=admin@yourcompany.com

# ------------------------------------------------------------------------------
# 2. SECURITY SECRETS (REQUIRED)
# Generate long, random strings (32+ chars) for each of these.
# ------------------------------------------------------------------------------
# Master secret used for signing user session JWTs
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# API token used for administrative actions
ADMIN_API_TOKEN=change_this_to_a_secure_random_token

# Token used for internal communication with the map-storage service
MAP_STORAGE_API_TOKEN=change_this_to_a_secure_random_map_storage_token

# Bearer authentication token for uploading maps via Map Storage Web UI / HTTP API
# (Defaults to MAP_STORAGE_API_TOKEN if left blank)
AUTHENTICATION_TOKEN=

# Secret key required to access the Room API over gRPC (:50051)
# (Defaults to SECRET_KEY if left blank)
ROOM_API_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. CONTAINER IMAGE VERSION
# ------------------------------------------------------------------------------
VERSION=v1.33.5

# ------------------------------------------------------------------------------
# 4. PUBLISHED PORTS
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
GRPC_PORT=50051

# ------------------------------------------------------------------------------
# 5. DEFAULT STARTING ROOM
# ------------------------------------------------------------------------------
# Official starter kit:
START_ROOM_URL=/_/global/workadventure.github.io/map-starter-kit/office.tmj
# Or your own persistent map-storage room:
# START_ROOM_URL=/_/global/${DOMAIN}/map-storage/my-office/map.json

# ------------------------------------------------------------------------------
# 6. VIDEO / AUDIO CONFERENCING
# ------------------------------------------------------------------------------
# Jitsi server for structured meeting rooms
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=false

# STUN server for WebRTC proximity audio/video bubbles
STUN_SERVER=stun:stun.l.google.com:19302

# ------------------------------------------------------------------------------
# 7. OPTIONAL LIVEKIT INTEGRATION
# Uncomment and populate to upgrade proximity media from WebRTC P2P to LiveKit SFU
# ------------------------------------------------------------------------------
# LIVEKIT_HOST=wss://your-livekit.example.com
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 8. FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_MAP_EDITOR=true
MAP_EDITOR_ALLOW_ALL_USERS=true
ENABLE_CHAT=true
ENABLE_CHAT_UPLOAD=true
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
ENABLE_TUTORIAL=true
DISABLE_ANONYMOUS=false
MAX_PER_GROUP=4
GROUP_RADIUS=48
MINIMUM_DISTANCE=64
RESTART_POLICY=unless-stopped
LOG_LEVEL=INFO
UPLOAD_MAX_FILESIZE=10485760
